# ─── Terraform State ───────────────────────────────────────────────────────────
# Never commit state files — they contain resource IDs, secrets, and full config
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan output (can contain secrets in plaintext)
*.tfplan
*.plan

# ─── Terraform Working Directory ───────────────────────────────────────────────
# Auto-generated by `terraform init` — contains provider binaries (~100MB+)
**/.terraform/
.terraform.lock.hcl        # Optionally commit this to lock provider versions
                           # Remove this line if you want to pin providers

# ─── OCI Credentials & Private Keys ───────────────────────────────────────────
# OCI API signing keys — CRITICAL: these authenticate to your OCI tenancy
*.pem
*.key
privkey.pem
oci_api_key.pem
oci_api_key_public.pem

# OCI CLI config (contains tenancy OCID, user OCID, key fingerprint)
~/.oci/config
.oci/

# ─── Terraform Variable Files with Secrets ─────────────────────────────────────
# tfvars files often contain OCIDs, credentials, CIDRs — exclude sensitive ones
# IMPORTANT: See note below about *.tfvars vs specific files
provider.tf
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ─── SSH Keys ──────────────────────────────────────────────────────────────────
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.ppk

# ─── Environment / Secrets Files ───────────────────────────────────────────────
.env
.env.*
.envrc
secrets.yml
secrets.json
credentials
credentials.json

# ─── Log Files ─────────────────────────────────────────────────────────────────
*.log
crash.log
crash.*.log

# ─── OS / Editor Artifacts ─────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# JetBrains IDEs (IntelliJ, PyCharm, etc.)
.idea/

# VS Code
.vscode/

# ─── Temporary Files ───────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.swp
*.bak
